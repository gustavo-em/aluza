{
  "react-native": {
    "crashlytics_disable_auto_disabler": true,
    "crashlytics_auto_collection_enabled": true,
    "analytics_auto_collection_enabled": true,
    "google_analytics_automatic_screen_reporting_enabled": false,
    "app_check_token_auto_refresh": true
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "docs/firebase/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/e/**",
        "function": "invite"
      },
      {
        "source": "/api/interpret",
        "function": "interpretCapture"
      },
      {
        "source": "/api/voice",
        "function": "voiceCapture"
      }
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/lesingo/support",
        "destination": "/lesingo/suporte#en",
        "type": 301
      },
      {
        "source": "/lesingo/privacy",
        "destination": "/lesingo/privacidade#en",
        "type": 301
      },
      {
        "source": "/lesingo/privacy-policy",
        "destination": "/lesingo/privacidade#en",
        "type": 301
      },
      {
        "source": "/lesingo/delete-account",
        "destination": "/lesingo/exclusao-de-conta#en",
        "type": 301
      },
      {
        "source": "/lesingo/account-deletion",
        "destination": "/lesingo/exclusao-de-conta#en",
        "type": 301
      },
      {
        "source": "/support",
        "destination": "/suporte#en",
        "type": 301
      },
      {
        "source": "/privacy",
        "destination": "/privacidade#en",
        "type": 301
      }
    ]
  }
}
